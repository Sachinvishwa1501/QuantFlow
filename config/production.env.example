QUANTFLOW_ENV=production
QUANTFLOW_DEBUG=false
QUANTFLOW_ENABLE_DOCS=false
QUANTFLOW_LOG_LEVEL=INFO
QUANTFLOW_API_HOST=0.0.0.0
QUANTFLOW_API_PORT=8000
QUANTFLOW_POSTGRES_DSN=postgresql+psycopg://quantflow:${QUANTFLOW_POSTGRES_PASSWORD}@production-postgres:5432/quantflow
QUANTFLOW_DUCKDB_PATH=/var/lib/quantflow/analytics.duckdb
